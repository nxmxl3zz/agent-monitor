#!/usr/bin/env bash
set -euo pipefail

monitor_root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
monitor_unit_name="agent-monitor-web.service"
monitor_unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
monitor_action="${1:-status}"
if [[ $# -gt 0 ]]; then shift; fi

case "$monitor_action" in
  install)
    if [[ ! -x "$monitor_root_dir/bin/openusage" ]]; then
      printf 'Build first with make build.\n' >&2
      exit 1
    fi
    monitor_extra_args=""
    for monitor_host in "$@"; do
      if [[ ! "$monitor_host" =~ ^[a-zA-Z0-9.-]+(:[0-9]+)?$ ]]; then
        printf 'Invalid host: use a hostname with an optional port.\n' >&2
        exit 2
      fi
      monitor_extra_args+=" --allow-host=$monitor_host"
    done
    mkdir -p "$monitor_unit_dir"
    monitor_launcher="$monitor_root_dir/scripts/agent-monitor"
    monitor_launcher="${monitor_launcher//\\/\\\\}"
    monitor_launcher="${monitor_launcher//\"/\\\"}"
    monitor_launcher="${monitor_launcher//%/%%}"
    monitor_launcher="${monitor_launcher//\$/\$\$}"
    printf '[Unit]\nDescription=Mobile view for Agent Monitor\nWants=agent-monitor.service\nAfter=agent-monitor.service\n\n[Service]\nType=simple\nExecStart="%s" web --listen=127.0.0.1:8787%s\nRestart=on-failure\nRestartSec=3\nUMask=0077\nNoNewPrivileges=true\n\n[Install]\nWantedBy=default.target\n' "$monitor_launcher" "$monitor_extra_args" > "$monitor_unit_dir/$monitor_unit_name"
    systemctl --user daemon-reload
    systemctl --user enable --now "$monitor_unit_name"
    systemctl --user restart "$monitor_unit_name"
    ;;
  start|stop|restart|status)
    systemctl --user "$monitor_action" "$monitor_unit_name"
    ;;
  uninstall)
    systemctl --user disable --now "$monitor_unit_name"
    rm -f -- "$monitor_unit_dir/$monitor_unit_name"
    systemctl --user daemon-reload
    ;;
  *)
    printf 'Usage: agent-monitor web-service {install [host[:port] ...]|start|stop|restart|status|uninstall}\n' >&2
    exit 2
    ;;
esac
